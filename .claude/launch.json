{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-c", "import http.server,os;PORT=int(os.environ.get('PORT','5173'));http.server.ThreadingHTTPServer.allow_reuse_address=True;http.server.ThreadingHTTPServer(('',PORT),http.server.SimpleHTTPRequestHandler).serve_forever()"],
      "autoPort": true
    }
  ]
}
