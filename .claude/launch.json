{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-c", "import http.server,socketserver,os;PORT=int(os.environ.get('PORT','5173'));socketserver.TCPServer.allow_reuse_address=True;socketserver.TCPServer(('',PORT),http.server.SimpleHTTPRequestHandler).serve_forever()"],
      "autoPort": true
    }
  ]
}
